---
import MenuPage from "../components/menu/categorySelector.jsx"
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { sanityClient } from "sanity:client";
import imageUrlBuilder from "@sanity/image-url";

import Order from "../components/Order.astro";

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

const categories = await sanityClient.fetch(
  `*[_type == "category"] | order(title asc) { _id, title, order, image }`
);

const items = await sanityClient.fetch(
  `*[_type == "menu"] | order(title asc) {
    _id,
    title,
    price,
    ingredients,
    allergy,
    category-> { _id, title, slug, image }
  }`
);

const categoriesWithImages = categories.map(cat => ({
  ...cat,
  imageUrl: urlFor(cat.image).width(400).format('webp').quality(80).url()
}));
---

<BaseLayout>
  <div class="page-container">
    <div class="page-title">
      <h3>Speisekarte</h3>
    </div>

    <MenuPage items={items} categories={categoriesWithImages} client:load />

  </div>

  <div class="order"><Order text="Klicken, um zu bestellen!" /></div>

  <style>
    .page-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 8.5rem;
    }

    .page-title {
      font-size: clamp(1.8rem, 6vw, 3rem);
      line-height: 2rem;
      width: 100%;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
    }

    .page-title:before,
    .page-title:after {
    content: "";
    height: 1px;
    max-width: 25%;
    opacity: 0.4;
    background: linear-gradient(to right, #0000, var(--color-piz-accent) 50%, #0000);
    flex: 1 1 0%;
    }

    .menu-container {
      max-width: 1900px;
      margin: 2rem auto 0 auto;
      padding: 2rem;
      font-family: "Georgia", serif;
    }

    @media (min-width: 769px) {
      .menu-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem 3rem;
      }
    }

    @media (min-width: 1200px) {
      .menu-container {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .menu-section {
      margin-bottom: 5rem;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 600;
      color: var(--color-piz-text-bright);
      padding-bottom: 0.5rem;
      text-align: center;
      text-transform: capitalize;
    }

    .order {
      width: 50%;
      margin: 0 auto;
    }
  </style>
</BaseLayout>
