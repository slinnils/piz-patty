---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { sanityClient } from "sanity:client";
import imageUrlBuilder from "@sanity/image-url";

import Order from "../components/Order.astro";

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

const items = await sanityClient.fetch(
  `*[_type == "menu"] | order(category asc, title asc) {
    _id,
    title,
    price,
    ingredients,
    allergy,
    category,
    image
  }`,
);

const grouped = items.reduce((acc, item) => {
  const cat = item.category ?? "Sonstiges";
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(item);
  return acc;
}, {});

const categoryOrder = ["burger", "kebab", "beilagen", "desserts", "getraenke"];

const sortedEntries = Object.entries(grouped).sort(([a], [b]) => {
  const indexA = categoryOrder.indexOf(a);
  const indexB = categoryOrder.indexOf(b);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

const categoryLabels = {
  getraenke: "Getränke",
};
---

<BaseLayout>
  <div class="page-container">
    <div class="page-title">
      <h3>Speisekarte</h3>
    </div>
    <div class="menu-container">
      {
        sortedEntries.map(([category, dishes]) => (
          <section class="menu-section">
            <h2 class="section-title">
              {categoryLabels[category] || category}
            </h2>

            <hr class="category-line" />

            <dl class="menu-list">
              {dishes.map((dish) => (
                <div class="menu-item">
                  {dish.image && (
                    <Image
                      src={urlFor(dish.image).width(800).url()}
                      alt={dish.title}
                      width={144}
                      height={144}
                      class:list="dish-image"
                    />
                  )}
                  <div class="product-text">
                    <dt class="dish-header">
                      <span class="dish-name">{dish.title}</span>
                      <span class="dish-price">
                        CHF {dish.price.toFixed(2)}
                      </span>
                    </dt>

                    {dish.ingredients && (
                      <dd class="dish-description">{dish.ingredients}</dd>
                    )}

                    <dd class="dish-allergy">
                      <small>
                        {dish.allergy ? "⚠" : ""} {dish.allergy}
                      </small>
                    </dd>
                  </div>
                </div>
                <hr class="card-seperator"/>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </div>

  <div class="order"><Order text="Klicken, um zu bestellen!" /></div>

  <style>
    .page-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 8.5rem;
    }

    .page-title {
      font-size: clamp(1.8rem, 6vw, 3rem);
      line-height: 2rem;
      width: 100%;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
    }

    .page-title:before,
    .page-title:after {
      content: "";
      width: 20%;
      max-width: 350px;
      height: 10px;
      border-top: 1px solid var(--color-piz-accent);
      border-bottom: 1px solid var(--color-piz-accent);
      margin-top: 0.6rem;
    }

    .menu-container {
      max-width: 1900px;
      margin: 2rem auto 0 auto;
      padding: 2rem;
      font-family: "Georgia", serif;
    }

    @media (min-width: 769px) {
      .menu-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem 3rem;
      }
    }

    @media (min-width: 1200px) {
      .menu-container {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .menu-section {
      margin-bottom: 5rem;
    }

    .section-title {
      font-size: 2rem;
      font-weight: 600;
      color: var(--color-piz-text-bright);
      padding-bottom: 0.5rem;
      text-align: center;
      text-transform: capitalize;
    }

    .category-line {
      margin: 0 auto;
      color: var(--color-piz-accent);
      width: 90%;
      box-shadow: 0 0px 19px var(--color-piz-accent);
    }

    .menu-list {
      margin: 0;
      padding: 0;
    }

    .menu-item {
      margin: 1rem 0;
    box-shadow: 0 5px 10px rgba(0, 0, 0, 0.158);
    }

    .card-seperator{
      border-bottom: 1px dotted #ddd;
    color: transparent;
    box-shadow: 0 0 0 transparent;
    margin: 0;
    width: 100%;
    }

    .menu-item:last-child {
      border-bottom: none;
    }

    .dish-image {
      width: 100%;
      max-height: 250px;
      object-fit: cover;
      border-radius: 8px 8px 0 0;
    }

    .product-text {
      border: 1px solid var(--color-piz-accent);
      border-top: 0;
      border-radius: 0 0 8px 8px;
      padding: 1rem;
    }

    .dish-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.5rem;
      font-weight: normal;
    }

    .dish-name {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--color-piz-text-mute);
      flex: 1;
    }

    .dish-price {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-piz-accent);
      margin-left: 1rem;
      white-space: nowrap;
    }

    .dish-description {
      margin: 0;
      padding-left: 0;
      color: #555;
      line-height: 1.5;
      font-style: italic;
    }

    @media(min-width: 769px){
      .dish-description{
        height: 150px;
      }
    }

    .dish-allergy {
      margin: 0.5rem 0 0;
      color: #888;
      font-size: 0.85rem;
      height: 21px;
    }

    @media (max-width: 768px) {
      .menu-container {
        padding: 1rem;
      }

      .dish-header {
        flex-direction: column;
        gap: 0.25rem;
      }

      .dish-price {
        margin-left: 0;
      }

      .section-title {
        font-size: 1.6rem;
      }
    }

    @media print {
      .menu-container {
        padding: 1rem;
      }

      .section-title {
        page-break-after: avoid;
      }

      .menu-item {
        page-break-inside: avoid;
      }
    }

    .order {
      width: 50%;
      margin: 0 auto;
    }
  </style>
</BaseLayout>
