---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout>
  <div class="contact">
  <div class="form-container">
    <div>
      <p class="section-title">Bei Fragen oder Anmerkungen können Sie sich gerne melden</p>
    </div>
    <form action="https://api.web3forms.com/submit" method="POST">
      <input
        type="hidden"
        name="access_key"
        value={import.meta.env.PUBLIC_WEB3FORMS_KEY}
      />
      <label class="title" for="name">Name</label>
      <input type="text" name="name" required />

      <label class="title" for="email">E-Mail-Adresse</label>
      <input type="email" name="email" required />

      <label class="title" for="message">Ihre Nachricht</label>
      <textarea name="message" required></textarea>
      <button class="secondary-btn" type="submit">Senden</button>

      
      <span>Ich melde mich in der Regel innert 24 Stunden.</span>

      <input type="checkbox" name="botcheck" style="display: none;" />
    </form>
  </div>

  <div class="info">
    <p class="section-title">Meine Kontaktangaben:</p>
    <p>Hans Muster</p>
    <a href="mailto:nils@grischa-web.ch">nils@grischa-web.ch</a>
    <a href="tel:+41799689805">+41 12 345 67 89</a>
    <p>Standort: Chur, Graubünden</p>
    <hr />
  </div>
</div>
</BaseLayout>

<style>
  .contact{
    display: flex;
    gap: 1.8rem;
    width: 100%;
    max-width: 1200px;
    justify-content: center;
    margin: 150px auto;
  }

  @media (max-width: 769px) {
    .contact {
      flex-direction: column;
      align-items: center;
    }
  }

  .section-title{
    color: var(--color-piz-text-bright);
    font-size: clamp(1.3rem, 5vw, 1.8rem);
  }

  @media (max-width: 769px) {
    section {
      flex-direction: column;
      align-items: center;
    }
  }

  .form-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    text-align: center;
    width: 100%;
    max-width: 536px;
    margin: 0 auto;
    padding: 2rem;
  }

  label {
    color: var(--color-piz-text-bright);
    font-size: clamp(1.5rem, 4vw, 1.8rem);
    align-self: flex-start;
  }

  form {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(1rem, 10vw, 2rem);
  }

  button {
    font-size: 1.2rem;
    cursor: pointer;
  }

  textarea {
    height: 200px;
  }

  input,
  textarea {
    margin: 0.5rem 0 1.6rem 0;
    padding: 0.2rem 1rem;
    width: 100%;
    max-width: 600px;
    font-size: 1.5rem;
    color: var(--color-piz-text-bright);
    background-color: var(--color-piz-card-bg);
    border-radius: 15px;
    border: 1px solid var(--color-piz-accent);
  }

  input:not([type="hidden"]):not([name="botcheck"]):focus,
  textarea:focus {
    outline: none;
    box-shadow: 0px 0px 20px var(--color-piz-shadow);
  }

  input,
  textarea {
    transition: box-shadow 0.3s;
  }

  span{
    font-size: 0.8rem;
    color: var(--color-piz-text-mute);
    margin-top: 1.5rem;
  }

  .info{
    width: 100%;
    text-align: center;
    font-size: clamp(1rem, 2.5vw, 1.5rem);

    color: var(--color-piz-text-bright);

    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  hr{
    display: none;
    margin-top: 2rem;
    width: 50%;
  }

  @media(min-width: 769px){
    hr{
      display: block;
    }
  }
</style>
