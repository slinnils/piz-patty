---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import OpeningHours from "../components/OpeningHours.astro";
import Map from "../components/Map.astro";
---

<BaseLayout>
  <section class="hero-wrapper">
    <div class="hero-text">
      <h2>Piz Patty</h2>
      <p>Dein Burger-Gipfel in Chur.</p>
    </div>

    <div class="btn-group">
      <a href="/menu" class="primary-btn">Zum Menü</a>
      <a href="/kontakt" class="primary-btn">Kontakt/ reservation</a>
    </div>
  </section>
  <div class="page-container">
    <section class="opening-hrs">
      <OpeningHours />
    </section>
    <hr class="divider1" />

    <section class="maps">
      <Map />
    </section>
    <hr class="divider2" />
  </div>
</BaseLayout>

<style>
  .page-container {
    display: grid;
    grid-template-rows: auto auto;
    grid-template-areas:
      "hero"
      "opening-hrs"
      "divider1"
      "maps"
      "divider2";
  }

  @media (min-width: 800px) {
    .page-container {
      padding: 0 3rem;
    }
  }

  hr {
    margin: 3rem auto;
    color: var(--color-piz-accent);
    width: 80vw;
    box-shadow: 0 0px 19px var(--color-piz-accent);
  }

  .divider1{
    grid-area: divider1;
  }
  .divider2{
    grid-area: divider2;
  }



  .hero-wrapper {
    top: 0;
    left: 0;
    background-image: url("../../src/assets/hero-burger.jpg");
    background-size: cover;
    background-position: right 0 bottom 35%;
    height: 55vh;
    width: 100%;

    border-bottom: 1px solid var(--color-piz-accent);
    box-shadow: 0px 0px 5px var(--color-piz-accent);

    display: grid;
    grid-template-rows: auto auto;
    grid-template-areas:
      "text"
      "btn";
    align-content: end;
    padding-bottom: 2rem;

    grid-area: hero;
  }

  .hero-wrapper::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 150px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent);
    z-index: 2;
  }

  @media (max-width: 600px) {
    .hero-wrapper {
      background-position: left 40% bottom 35%;
    }
  }

  .hero-text {
    color: var(--color-piz-text-bright);
    text-shadow: 0 8px 8px rgba(0, 0, 0, 0.7);
    width: 95%;

    display: flex;
    flex-direction: column;

    grid-area: text;
    place-self: end;
  }

  .hero-wrapper h2 {
    font-size: clamp(3rem, 10vw, 5rem);
  }

  .hero-wrapper p {
    font-size: clamp(1rem, 5vw, 3rem);
  }

  .btn-group {
    display: flex;
    gap: 1rem;
    margin: 2rem auto 0 auto;

    height: 50px;

    grid-area: btn;
  }

  .opening-hrs {
    grid-area: opening-hrs;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .opening-hrs {
      flex-direction: row;
      align-items: start;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  .maps {
    grid-area: maps;
    justify-items: center;
  }
</style>
