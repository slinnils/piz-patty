---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero-wrapper">
    <div class="hero-text">
      <h2>Piz Patty</h2>
      <p>Dein Burger-Gipfel in Chur.</p>
    </div>

    <div class="btn-group">
      <button class="primary-btn">Zum Menü</button>
      <button class="primary-btn">Reservation/ Standort</button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    background-image: url("../../src/assets/hero-burger.jpg");
    background-size: cover;
    background-position: right 0 bottom 35%;
    height: 85vh;
    width: 100%;

    display: grid;
    grid-template-rows: auto auto;
    grid-template-areas:
      "text"
      "btn";
    align-content: end;
	padding-bottom: 2rem;
  }

  @media (max-width: 600px){
	.hero-wrapper{
    background-position: left 40% bottom 35%;
	}
  }

  .hero-text {
    color: var(--color-piz-text-bright);
    text-shadow: 0 8px 8px rgba(0, 0, 0, 0.7);
    width: 95%;

    display: flex;
    flex-direction: column;

    grid-area: text;
    place-self: end;
  }

  .hero-wrapper h2 {
    font-size: clamp(3rem, 10vw, 5rem);
  }

  .hero-wrapper p {
    font-size: clamp(1rem, 5vw, 3rem);
  }

  .btn-group {
    display: flex;
    gap: 1rem;
    margin: 2rem auto 0 auto;

    height: 50px;

    grid-area: btn;
  }

  /*Mountain divider
  .mountain-divider {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
  }

  .mountain-divider svg {
    width: 100%;
    height: 90px;
    display: block;
  }

  .mountain-divider path {
    fill: var(--color-piz-bg);
  }*/
</style>
