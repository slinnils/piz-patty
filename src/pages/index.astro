---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import OpeningHours from "../components/OpeningHours.astro";
import StoreVideo from "../assets/piz-patty-vid.mp4";
import Order from "../components/Order.astro";
---

<BaseLayout>
  <section class="hero-wrapper">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/piz-patty-laden-poster.jpg"
      class="hero-video"
    >
      <source src={StoreVideo} />
      Dein Browser unterstützt keine Videos.
    </video>
    <div class="hero-text">
      <h1>Piz Patty</h1>
      <h3>Dein Burger-Gipfel in Chur.</h3>
    </div>

    <div class="btn-group">
      <a href="/menu" class="secondary-btn">Zum Menü</a>
      <a href="/kontakt" class="primary-btn">Kontakt/ reservation</a>
    </div>
  </section>

  <div class="page-container">
    <OpeningHours />

    <hr class="divider2" />

    <section class="order">
      <Order text="Hungrig? Bestelle direkt bei uns:" />
    </section>
  </div>
</BaseLayout>

<script>
  const video = document.querySelector(".hero-video");

  function updateParallax() {
    if (!video) return;

    video.style.transform = `translateY(${window.scrollY * 0.4}px)`;
  }

  updateParallax();
  window.addEventListener("scroll", updateParallax);
</script>

<style>
  .page-container {
    display: grid;
    grid-template-rows: auto auto;
    grid-template-areas:
      "hero"
      "opening-hrs"
      "divider1"
      "maps"
      "divider2"
      "order";
    padding: 0 1rem;
  }

  @media (min-width: 800px) {
    .page-container {
      padding: 0 1rem;
      max-width: 1800px;
      margin: 0 auto;
    }
  }

  .divider2 {
    grid-area: divider2;
  }

  .hero-wrapper {
    position: relative;
    height: 60vh;
    overflow: hidden;

    border-bottom: 1px solid var(--color-piz-accent);
    box-shadow: 0px 0px 15px #d4aa3773;

    border-bottom: 1px solid var(--color-piz-accent);
    box-shadow: 0px 0px 15px #d4aa3773;

    display: grid;
    grid-template-rows: auto auto;
    grid-template-areas:
      "text"
      "btn";
    align-content: end;
    padding-bottom: 2rem;

    margin-bottom: 2rem;

    grid-area: hero;
  }

  .hero-wrapper::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 150px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.7), transparent);
    z-index: 2;
  }

  @media (max-width: 600px) {
    .hero-wrapper {
      background-position: left 40% bottom 35%;
    }
  }

  @media (min-width: 1800px) {
    .hero-wrapper {
      border: 1px solid var(--color-piz-accent);
      border-radius: 0 0 20px 20px;
      border-top: 0;
    }
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero-text {
    color: var(--color-piz-text-bright);
    text-shadow: 0 8px 8px rgba(0, 0, 0, 0.7);
    width: 95%;

    display: flex;
    flex-direction: column;

    grid-area: text;
    place-self: end;
  }

  .hero-wrapper h1 {
    font-size: clamp(3rem, 10vw, 5rem);
  }

  .hero-wrapper h3 {
    font-size: clamp(1rem, 5vw, 3rem);
  }

  .btn-group {
    grid-area: btn;
  }

  .opening-hrs {
    grid-area: opening-hrs;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 930px) {
    .opening-hrs {
      flex-direction: row;
      align-items: start;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  .maps {
    grid-area: maps;
    justify-items: center;
  }

  .order {
    grid-area: order;
  }
</style>
