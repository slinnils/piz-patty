---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import OpeningHours from "../components/OpeningHours.astro";
---

<BaseLayout>
  <div class="page-container">
    <section class="hero-wrapper">
      <div class="hero-text">
        <h2>Piz Patty</h2>
        <p>Dein Burger-Gipfel in Chur.</p>
      </div>

      <div class="btn-group">
        <a href="/menu" class="primary-btn">Zum Menü</a>
        <a href="/kontakt" class="primary-btn">Kontakt/ reservation</a>
      </div>
    </section>

    <section class="opening-hrs">
      <OpeningHours />
    </section>
    <hr />

    <section class="maps">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2724.8866859512036!2d9.529103988022067!3d46.847550096718244!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4784c7703541f30d%3A0xde0fbb72e864f7bb!2sBargers%20Kebab!5e1!3m2!1sen!2sch!4v1773391149042!5m2!1sen!2sch"
        width="300"
        height="300"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
  </div>
</BaseLayout>

<style>
  .page-container {
    display: grid;
    grid-template-rows: auto auto;
    grid-template-areas:
      "hero"
      "opening-hrs";
  }

  hr {
    margin: 2rem auto;
    color: var(--color-piz-accent);
    width: 80vw;
    box-shadow: 0 0px 19px var(--color-piz-accent);
  }

  .hero-wrapper {
    top: 0;
    left: 0;
    background-image: url("../../src/assets/hero-burger.jpg");
    background-size: cover;
    background-position: right 0 bottom 35%;
    height: 85vh;
    width: 100%;

    border-bottom: 1px solid var(--color-piz-accent);
    box-shadow: 0px 0px 5px var(--color-piz-accent);

    display: grid;
    grid-template-rows: auto auto;
    grid-template-areas:
      "text"
      "btn";
    align-content: end;
    padding-bottom: 2rem;

    grid-area: hero;
  }

  @media (max-width: 600px) {
    .hero-wrapper {
      background-position: left 40% bottom 35%;
    }
  }

  .hero-text {
    color: var(--color-piz-text-bright);
    text-shadow: 0 8px 8px rgba(0, 0, 0, 0.7);
    width: 95%;

    display: flex;
    flex-direction: column;

    grid-area: text;
    place-self: end;
  }

  .hero-wrapper h2 {
    font-size: clamp(3rem, 10vw, 5rem);
  }

  .hero-wrapper p {
    font-size: clamp(1rem, 5vw, 3rem);
  }

  .btn-group {
    display: flex;
    gap: 1rem;
    margin: 2rem auto 0 auto;

    height: 50px;

    grid-area: btn;
  }

  .opening-hrs {
    grid-area: opening-hrs;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
  }

  @media (min-width: 800px) {
    .opening-hrs {
      flex-direction: row;
      align-items: start;
      justify-content: space-between;
      gap: 1rem;
    }
  }
</style>
