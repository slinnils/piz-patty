---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero-wrapper">
    <div class="hero-text">
      <h2>Piz Patty</h2>
      <p>Dein Burger-Gipfel in Chur.</p>
    </div>

  </section>
</BaseLayout>

<style>
  .hero-wrapper {
    position: relative;
    left: 0;
    top: calc(-160px + -32px);
    z-index: -10;
    background-image: url("../../src/assets/hero-burger.jpg");
    background-size: cover;
    background-position: right 0 bottom 35%;
    height: 85vh;
  }

  .hero-text {
    position: absolute;
    bottom: 100px;
    left: 50px;
    color: var(--color-piz-text-bright);
  }

  .hero-wrapper h2 {
    font-size: clamp(3rem, 10vw, 5rem);
  }

  .hero-wrapper p {
    font-size: clamp(1rem, 5vw, 3rem);
  }

  /*Mountain divider
  .mountain-divider {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
  }

  .mountain-divider svg {
    width: 100%;
    height: 90px;
    display: block;
  }

  .mountain-divider path {
    fill: var(--color-piz-bg);
  }*/
</style>
