---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/piz-patty-favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Piz Patty Burger</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Ranchers&family=Sour+Gummy:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-piz-bg">
    <div id="header">
      <Header />
    </div>

    <main id="main">
      <slot />
    </main>
  </body>

  <footer id="footer">
    <Footer />
  </footer>
</html>

<style>
  body {
    display: grid;
    grid-template-rows: auto auto auto;
    grid-template-columns: 1fr;
    grid-template-areas:
      "header"
      "main"
      "footer";
    height: 100dvh;
    width: 100%;
    max-width: 2000px;
    margin: 0 auto;
  }

  #header {
    grid-area: header;
  }

  #main {
    grid-area: main;
  }

  #footer {
    grid-area: footer;
    place-self: center;
  }
</style>
