---
import storeFront from "../assets/piz-patty-laden.png";
---

<div class="map-section fade-in">
  <img class="store-img" src={storeFront.src} alt="" />
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d103839.12000696166!2d9.465088716769689!3d46.83157372969!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4784c7768af75b55%3A0x2b4f78a6d7011f30!2sChur!5e1!3m2!1sen!2sch!4v1773675255379!5m2!1sen!2sch"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    >
    </iframe>
</div>

<style>
  .map-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;

    width: 100%;
  }

  @media (min-width: 800px) {
    .map-section {
      flex-direction: column;
    }
  }

  @media (min-width: 1400px) {
    .map-section {
      flex-direction: row;
    }
  }

  .store-img {
    width: 400px;
    border: 1px solid var(--color-piz-accent);
    border-radius: 15px;
    box-shadow: 0px 3px 18px #d4aa3773;
  }

  iframe {
    border-radius: 15px;
    min-width: 300px;
  }

  @media (min-width: 800px) {
    .maps-text {
      order: -1;
    }

    iframe {
      width: 400px;
      height: 300px;
    }
  }

  .maps-text p {
    width: clamp(300px, 40vw, 500px);
    flex-grow: 1;
    display: inline;
  }
</style>
