---
import storeFront from "../assets/piz-patty-laden.png";
---

<div class="map-section">
  <div class="location-group">
    <img class="store-img" src={storeFront.src} alt="" />
    <div class="map-container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d103839.12000696166!2d9.465088716769689!3d46.83157372969!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4784c7768af75b55%3A0x2b4f78a6d7011f30!2sChur!5e1!3m2!1sen!2sch!4v1773675255379!5m2!1sen!2sch"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      >
      </iframe>
    </div>
  </div>

  <div class="maps-text">
    <p class="main-text">Hier findest du uns</p>
  </div>
</div>

<style>
  .map-section {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
  }

  @media (min-width: 800px) {
    .map-section {
      flex-direction: row;
      width: 100%;
      max-width: 1400px;
    }
  }

  @media (min-width: 1800px) {
    .map-section {
      margin: 0 auto;
    }
  }

  .store-img {
    width: 400px;
    border: 1px solid var(--color-piz-accent);
    border-radius: 15px;
    box-shadow: 0px 3px 18px #d4aa3773;
  }

  .location-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .map-container {
    border: 1px solid var(--color-piz-accent);
    border-radius: 15px;
    box-shadow: 0px 3px 18px #d4aa3773;
  }

  iframe {
    border-radius: 15px;
    width: 100%;
    height: 250px;
  }

  @media(min-width: 1080px){
    
    .location-group {
      flex-direction: row;
    }
  }

  @media (min-width: 800px) {
    .maps-text {
      order: -1;
    }

    iframe {
      width: 400px;
      height: 300px;
    }
  }

  .maps-text p {
    width: clamp(300px, 40vw, 500px);
    flex-grow: 1;
    display: inline;
  }
</style>
