<div class="map-section">
  <div class="map-container">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d481.6728054404403!2d9.536090082478257!3d46.85018818473923!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4784c77a2faa83fd%3A0x973b7139f8775694!2sHaldenh%C3%BCttli!5e1!3m2!1sen!2sch!4v1773414170748!5m2!1sen!2sch"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    >
    </iframe>
  </div>

  <div class="maps-text">
    <p>Hier findest du uns</p>
  </div>
</div>

<style>
.map-section{
    display: flex;
    flex-direction: column;
    
    gap: 0.5rem;
}


  @media(min-width: 800px){
    .map-section{
    flex-direction: row;
    width: 100%;
    }
  }
    
  .map-container {
    border: 1px solid var(--color-piz-accent);
    border-radius: 15px;
    box-shadow: 0px 3px 18px #d4aa3773;
    margin: auto auto;
  }

  iframe {
    border-radius: 15px;
    width: 300px;
    height: 300px;
  }

  @media (min-width: 800px) {
    .maps-text {
      order: -1;
      margin: auto auto;
    }

    iframe{
        width: 400px;
        height: 400px;
    }
  }

  .maps-text {
    display: flex;
    color: var(--color-piz-text-mute);
    width: clamp(300px, 40vw, 500px);
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .maps-text p{
    flex-grow: 1;
  }
</style>
