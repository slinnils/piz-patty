<style>
  .footer-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 0 1rem;
  }

  .container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    margin-bottom: 2rem;
    width: 80%;
  }

  a:not(.tel) {
    color: var(--color-piz-text-bright);
    font-size: 1.2rem;
    cursor: pointer;
    font-family: "Playfair Display", serif;
    font-optical-sizing: auto;
    font-weight: 600;
    font-style: normal;
  }

  a:not(.tel):hover {
    color: var(--color-piz-text-mute);
    font-family: "Playfair Display", serif;
    font-optical-sizing: auto;
    font-weight: 600;
    font-style: normal;
  }

  @media (min-width: 800px) {
    .container {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  hr {
    color: var(--color-piz-text-mute);
    width: 100%;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tel {
    color: var(--color-piz-text-mute);
  }

  .copyright {
    color: var(--color-piz-text-mute);
    margin-bottom: 0.2rem;
  }

  a:hover {
    color: var(--color-piz-text-bright);
  }

  p {
    color: var(--color-piz-text-mute);
  }

  .sm-group {
    margin-top: 0.3rem;

    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
