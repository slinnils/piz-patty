---
import { sanityClient } from "sanity:client";

const openingHours = await sanityClient.fetch(
  '*[_type == "openingHours"][0]{montagBisDonnerstag, freitagUndSamstag, sonntag}',
);
---

<div class="hrs-container">
  <h3>Unsere Öffnungszeiten:</h3>
  <dl class="opening-hours">
    <div>
      <dt>Montag - Donnerstag:</dt>
      <dd>{openingHours.montagBisDonnerstag}</dd>
    </div>

    <div>
      <dt>Freitag & Samstag:</dt>
      <dd>{openingHours.freitagUndSamstag}</dd>
    </div>

    <div>
      <dt>Sonntag:</dt>
      <dd>{openingHours.sonntag}</dd>
    </div>
  </dl>
</div>
<div class="opening-hrs-text">
  <p class="main-text">Komm vorbei</p>
  <p class="main-text">-</p>
  <p class="main-text">Wir sind da!</p>
</div>

<style>
  .hrs-container {
    width: 100%;
    margin: 2rem 0 0.5rem 0;
    background-color: var(--color-piz-card-bg);
    padding: 1rem 2rem;
    border: 1px solid var(--color-piz-accent);
    border-radius: 8px;
    box-shadow: 0px 3px 18px #d4aa3773;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 400;
  }

  .opening-hours div {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 3px solid var(--color-piz-card-bg);
  }

  .opening-hours dt {
    color: var(--color-piz-text-bright);
    font-weight: 300;
    margin-right: 1rem;
  }

  .opening-hours dd {
    color: var(--color-piz-accent);
  }

  @media (min-width: 800px) {
    .opening-hours dt,
    dd {
      font-size: clamp(1rem, 50vw, 1.8rem);
    }

    .hrs-container {
      width: clamp(200px, 80%, 800px);
    }

    h3 {
      font-size: clamp(1.5rem, 50vw, 2rem);
    }
  }

  .opening-hrs-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: clamp(300px, 10vw, 500px);
  }
</style>
