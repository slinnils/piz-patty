---
import storeFront from "../assets/piz-patty-laden.png";
import { sanityClient } from "sanity:client";
import { Image } from 'astro:assets';

const openingHours = await sanityClient.fetch(
  '*[_type == "openingHours"][0]{montagBisDonnerstag, freitagUndSamstag, sonntag}',
);
---

<section>
  <div class="hrs-container">
    <h3>Unsere Öffnungszeiten:</h3>
    <dl class="opening-hours">
      <div>
        <dt>Montag - Donnerstag:</dt>
        <dd>{openingHours.montagBisDonnerstag}</dd>
      </div>

      <div>
        <dt>Freitag & Samstag:</dt>
        <dd>{openingHours.freitagUndSamstag}</dd>
      </div>

      <div>
        <dt>Sonntag:</dt>
        <dd>{openingHours.sonntag}</dd>
      </div>
    </dl>
  </div>

  <div class="map-section">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d103839.12000696166!2d9.465088716769689!3d46.83157372969!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4784c7768af75b55%3A0x2b4f78a6d7011f30!2sChur!5e1!3m2!1sen!2sch!4v1773675255379!5m2!1sen!2sch"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    >
    </iframe>
    <Image class:list="store-img" src={storeFront} alt="Bild vom Ladeneingang" format="webp"/>
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 1550px) {
    section {
      flex-direction: row;
    }
  }

  .hrs-container {
    width: 100%;
    max-width: 810px;
    background-color: var(--color-piz-card-bg);
    padding: 1.5rem 2rem;
    border-radius: 8px;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 400;
  }

  .opening-hours div {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 3px solid var(--color-piz-card-bg);
  }

  .opening-hours dt {
    color: var(--color-piz-text-bright);
    font-weight: 300;
    margin-right: 1rem;
  }

  .opening-hours dd {
    color: var(--color-piz-accent);
  }

  @media (min-width: 800px) {
    .opening-hours dt,
    dd {
      font-size: clamp(0.8rem, 5vw, 1.5rem);
    }

    h3 {
      font-size: clamp(1.5rem, 50vw, 2rem);
    }
  }

  .map-section {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 800px) {
    .map-section {
      flex-direction: row;
    }
  }

  .store-img,
  iframe {
    max-width: 100%;
    width: 400px;
    height: 300px;
    object-fit: cover;
    border-radius: 8px;
  }

  iframe {
    border-radius: 8px;
    min-width: 300px;
  }

  @media (min-width: 800px) {
    .maps-text {
      order: -1;
    }

    iframe {
      width: 400px;
      height: 300px;
    }
  }

  .maps-text p {
    width: clamp(300px, 40vw, 500px);
    flex-grow: 1;
    display: inline;
  }
</style>
