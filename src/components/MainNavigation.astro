---

<nav class="ml-auto">
  <div class="flex justify-between items-center fixed top-0 right-0 z-60">
    <button id="menu-toggle">☰</button>
  </div>

  <div id="overlay" class="overlay"></div>

  <ul id="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/menu">Menü</a></li>
    <li><a href="/kontakt">Kontakt</a></li>
  </ul>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-links");
  const overlay = document.getElementById("overlay");

  function toggleMenu() {
    nav.classList.toggle("open");
    overlay.classList.toggle("open");
    toggle.textContent = nav.classList.contains("open") ? "✕" : "☰";
  }

  toggle.addEventListener("click", toggleMenu);
  overlay.addEventListener("click", toggleMenu);
</script>

<style>
  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  #menu-toggle {
    color: var(--color-piz-text-bright);
    font-size: 1.8rem;
    margin: 1.5rem 1.5rem 0 auto;
    cursor: pointer;
  }

  #nav-links {
    position: fixed;
    top: 0;
    right: 0;
    height: 100dvh;
    width: 70%;

    font-size: clamp(1.3rem, 6.5vw, 2rem);

    background-color: var(--color-piz-card-bg);
    color: var(--color-piz-accent);
    backdrop-filter: blur(7px);

    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    padding: 0 4rem 0rem 1rem;
    list-style: none;
  }

  @media (min-width: 800px) {
    #nav-links {
      position: static;
      font-size: clamp(1.2rem, 2.3vw, 2rem);
      transform: translateX(0%);
      width: 100%;

      color: var(--color-piz-accent);

      background-color: transparent;
      backdrop-filter: blur(0px);

      height: auto;
      flex-direction: row;
      gap: 2rem;
    }
  }

  #nav-links li {
    opacity: 0;
    transform: translateX(20px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
    background-color: var(--color-piz-card-bg);

    border-radius: 10px;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #nav-links a {
    text-align: center;
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    display: inline-block;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  #nav-links a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-piz-accent);
    transform: translateX(-120%);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 800px) {
    #nav-links li {
      transform: translateX(0);
      opacity: 1;
      background-color: transparent;
    }

    #nav-links a:hover::after {
      transform: translateX(0);
    }
  }

  #nav-links.open li {
    opacity: 1;
    transform: translateX(0);
  }

  #nav-links.open li:nth-child(1) {
    transition-delay: 0.1s;
  }
  #nav-links.open li:nth-child(2) {
    transition-delay: 0.15s;
  }
  #nav-links.open li:nth-child(3) {
    transition-delay: 0.2s;
  }
  #nav-links.open li:nth-child(4) {
    transition-delay: 0.25s;
  }
  #nav-links.open li:nth-child(5) {
    transition-delay: 0.3s;
  }

  #nav-links.open {
    transform: translateX(0);
  }

  @media (min-width: 800px) {
    #menu-toggle {
      display: none;
    }

    .overlay {
      display: none;
    }
  }
</style>
