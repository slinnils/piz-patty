---
import { Image } from "astro:assets";
import MainNavigation from "./MainNavigation.astro";
import logo from "../assets/piz-patty-logo.png";
---

<header class="header-container">
  <a href="/">
    <div class="title-container">
      <Image
        id="logo-img"
        src={logo}
        alt="Piz Patty Logo"
        width={144}
        format="webp"
      />
    </div>
  </a>
  <nav class="ml-auto">
    <div class="flex justify-between items-center fixed top-0 right-0 z-60">
      <button id="menu-toggle">☰</button>
    </div>

    <div id="overlay" class="overlay"></div>

    <ul id="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/menu">Menü</a></li>
      <li><a href="/kontakt">Kontakt</a></li>
    </ul>
  </nav>
</header>

<script>
  /*HEADER:*/
  const header = document.querySelector("header");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  });

  /*NAVBAR:*/
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-links");
  const overlay = document.getElementById("overlay");

  function toggleMenu() {
    nav.classList.toggle("open");
    overlay.classList.toggle("open");
    toggle.textContent = nav.classList.contains("open") ? "✕" : "☰";
  }

  toggle.addEventListener("click", toggleMenu);
  overlay.addEventListener("click", toggleMenu);
</script>

<style>
  /*HEADER: */
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    padding: 1rem 0 0 1rem;
    transition: all 0.3s ease;
    display: flex;
    gap: 1rem;
  }

  @media (min-width: 1800px) {
    header {
      max-width: 1800px;
      left: auto;
      right: auto;
    }
  }

  .title-container {
    display: flex;
    align-items: center;
    gap: 2em;
  }

  #logo-img {
    width: clamp(80px, 20vw, 120px);
    height: clamp(80px, 20vw, 120px);
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    color: var(--color-piz-accent);
    text-shadow: 0 2px 8px var(--color-piz-card-bg);
  }

  header.scrolled {
    height: auto;
    padding: 0.2rem 2rem;
    backdrop-filter: blur(4px);
  }

  header.scrolled #logo-img {
    width: 65px;
    height: 65px;
    transition: all 0.3s ease;
  }

  @media (min-width: 800px) {
    header.scrolled #nav-links {
      font-size: clamp(1.2rem, 3vw, 1.5rem);
      padding-right: 0;
      transition: 550ms ease;
    }
  }

  /*NAVBAR: */

  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.6);
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  #menu-toggle {
    color: var(--color-piz-accent);
    font-size: 1.8rem;
    margin: 1.5rem 1.5rem 0 auto;
    cursor: pointer;
  }

  #nav-links {
    position: fixed;
    top: 0;
    right: 0;
    height: 100dvh;
    width: 60%;

    font-size: clamp(1.3rem, 6.5vw, 2rem);

    background-color: var(--color-piz-card-bg);
    color: var(--color-piz-accent);
    backdrop-filter: blur(7px);

    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 40;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    padding: 0 4rem 0rem 1rem;
    list-style: none;
  }

  @media (min-width: 800px) {
    #nav-links {
      position: static;
      font-size: clamp(1.5rem, 3vw, 2rem);
      transform: translateX(0%);
      width: 100%;

      color: var(--color-piz-accent);

      background-color: transparent;
      backdrop-filter: blur(0px);

      height: auto;
      flex-direction: row;
      gap: 2rem;
    }
  }

  #nav-links li {
    opacity: 0;
    transform: translateX(20px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;

    border-radius: 10px;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #nav-links a {
    text-align: center;
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    display: inline-block;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  #nav-links a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-piz-accent);
    transform: translateX(-120%);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 800px) {
    #nav-links li {
      transform: translateX(0);
      opacity: 1;
      background-color: transparent;
    }

    #nav-links a:hover::after {
      transform: translateX(0);
    }
  }

  #nav-links.open li {
    opacity: 1;
    transform: translateX(0);
  }

  #nav-links.open li:nth-child(1) {
    transition-delay: 0.1s;
  }
  #nav-links.open li:nth-child(2) {
    transition-delay: 0.15s;
  }
  #nav-links.open li:nth-child(3) {
    transition-delay: 0.2s;
  }
  #nav-links.open li:nth-child(4) {
    transition-delay: 0.25s;
  }
  #nav-links.open li:nth-child(5) {
    transition-delay: 0.3s;
  }

  #nav-links.open {
    transform: translateX(0);
  }

  @media (min-width: 800px) {
    #menu-toggle {
      display: none;
    }

    .overlay {
      display: none;
    }
  }
</style>
