---
import MainNavigation from "./MainNavigation.astro";
---

<header class="header-container">
  <img
    id="logo-img"
    src="../../src/assets/piz-patty-logo.png"
    width="10px"
    alt=""
  />
  {/*<a href="/"><h1 class="text-5xl text-piz-text-bright">Piz Patty</h1></a>*/}
  <MainNavigation />
</header>

<style>
  header {
  background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
  z-index: 90;
  padding: 1rem 0 0 1.5rem;
  }

  #logo-img {
    width: clamp(80px, 20vw, 120px);
    height: clamp(80px, 20vw, 120px);
    border-radius: 50%;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    color: var(--color-piz-accent);
    text-shadow: 0 2px 8px red;
  }

  .header-container {
    display: flex;
    gap: 1rem;
  }
</style>
